<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RazorClassLibrary>true</RazorClassLibrary>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <EnableDefaultEmbeddedStaticWebAssets>true</EnableDefaultEmbeddedStaticWebAssets>
        <StaticWebAssetBasePath>dx</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ballware.shared.authorization" Version="1.1.0" />
      <PackageReference Include="DevExpress.AspNetCore.Reporting" Version="26.1.6" />
      <PackageReference Include="DevExpress.Blazor.Reporting.JSBasedControls" Version="26.1.6" />
      <PackageReference Include="DevExpress.Drawing" Version="26.1.6" />
      <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.6" />
      <PackageReference Include="DevExpress.Pdf.SkiaRenderer" Version="26.1.6" />
      <PackageReference Include="DevExpress.Web.Reporting.Common" Version="26.1.6" />
      <PackageReference Include="Quartz" Version="3.8.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Ballware.Document.Metadata\Ballware.Document.Metadata.csproj" />
    </ItemGroup>

</Project>
