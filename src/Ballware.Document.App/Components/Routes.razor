<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Routes).Assembly"
            AdditionalAssemblies="new[] { typeof(Ballware.Document.Engine.Dx.Components.Designer).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <p role="alert">Sie sind nicht berechtigt, diese Seite anzuzeigen.</p>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Seite nicht gefunden.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
